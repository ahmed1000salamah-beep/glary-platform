# GEMINI_API_KEY: مفتاح واجهة Gemini AI - يتم استدعاؤه من السيرفر الخلفي فقط ولا يصل للمتصفح إطلاقاً
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: المفتاح السري لتوقيع والتحقق من توكنات الجلسات المشفرة (JWT) لحسابات المعلم والسكرتير
# قيمة عشوائية قوية وطويلة لحماية الجلسات من التلاعب
JWT_SECRET="glary_secure_super_secret_jwt_key_2026_change_in_production"

# PORT: منفذ تشغيل سيرفر الـ Node.js / Express (الافتراضي 3000)
PORT="3000"

# NODE_ENV: بيئة التشغيل ('development' للدمج المباشر مع Vite، أو 'production' للإنتاج)
NODE_ENV="development"

# DATABASE_PATH: مسار ملف قاعدة بيانات SQLite لتخزين الحسابات والطلاب والمحتوى
DATABASE_PATH="./data/glary.db"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

